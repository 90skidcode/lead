generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("active") // active|suspended
  plan      String   @default("starter")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                     TenantUser[]
  teams                     Team[]
  invitations               Invitation[]
  auditLogs                 AuditLog[]
  impersonationSessions     ImpersonationSession[]
  companies                 Company[]
  contacts                  Contact[]
  leadSources               LeadSource[]
  tags                      Tag[]
  leads                     Lead[]
  leadContacts              LeadContact[]
  leadTags                  LeadTag[]
  customFieldDefinitions    CustomFieldDefinition[]
  customFieldValues         CustomFieldValue[]
  savedViews                SavedView[]
  importJobs                ImportJob[]
  pipelines                 Pipeline[]
  pipelineStages            PipelineStage[]
  activities                Activity[]
  notes                     Note[]
  tasks                     Task[]
  automationRules           AutomationRule[]
  automationRuns            AutomationRun[]
  leadScoreHistories        LeadScoreHistory[]
  emailSequences            EmailSequence[]
  notifications             Notification[]
  reportSnapshots           ReportSnapshot[]
  csvExports                CsvExport[]
  tenantSettings            TenantSettings?
  notificationPreferences   NotificationPreference[]
  syncStatuses              SyncStatus[]

  @@index([slug])
  @@map("tenants")
}

model User {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String   @unique
  passwordHash         String   @map("password_hash")
  emailVerifiedAt      DateTime? @map("email_verified_at")
  isPlatformSuperAdmin Boolean  @default(false) @map("is_platform_super_admin")
  status               String   @default("active") // active|disabled
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenants                        TenantUser[]
  invitedInvitations             Invitation[] @relation("invitedBy")
  createdAuditLogs               AuditLog[]   @relation("actor")
  impersonationSessionsAsAdmin   ImpersonationSession[] @relation("superAdminImpersonation")
  impersonationSessionsAsTarget  ImpersonationSession[] @relation("targetImpersonation")
  ownedLeads                     Lead[] @relation("leadOwner")
  savedViews                     SavedView[]
  importJobs                     ImportJob[]
  activities                     Activity[]
  notes                          Note[]
  assignedTasks                  Task[]
  notifications                  Notification[]
  csvExports                     CsvExport[]
  notificationPreferences        NotificationPreference[]
  syncStatuses                   SyncStatus[]

  @@map("users")
}

model TenantUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  userId    String   @db.Uuid @map("user_id")
  role      String   // OWNER|ADMIN|MANAGER|SALES_REP|VIEWER
  teamId    String?  @db.Uuid @map("team_id")
  status    String   @default("active") // active|invited|deactivated
  invitedBy String?  @db.Uuid @map("invited_by")
  invitedAt DateTime? @map("invited_at")
  joinedAt  DateTime? @map("joined_at")
  deactivatedAt DateTime? @map("deactivated_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  inviter   User?  @relation("invitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@map("tenant_users")
}

model Team {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  name        String
  managerUserId String? @db.Uuid @map("manager_user_id")
  status      String   @default("active") // active|inactive
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     TenantUser[]
  leads       Lead[]

  @@index([tenantId])
  @@map("teams")
}

model Invitation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  email       String
  role        String   // OWNER|ADMIN|MANAGER|SALES_REP|VIEWER
  teamId      String?  @db.Uuid @map("team_id")
  tokenHash   String   @map("token_hash")
  status      String   @default("pending") // pending|accepted|cancelled|expired
  invitedBy   String   @db.Uuid @map("invited_by")
  expiresAt   DateTime @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter     User   @relation("invitedBy", fields: [invitedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, email, tokenHash])
  @@index([tenantId, status])
  @@map("invitations")
}

model AuditLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String?  @db.Uuid @map("tenant_id")
  actorUserId      String   @db.Uuid @map("actor_user_id")
  actorIsSuperAdmin Boolean  @default(false) @map("actor_is_super_admin")
  action           String
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  metadata         Json     @default("{}")
  ipAddress        String?  @map("ip_address")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor     User    @relation("actor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model ImpersonationSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  superAdminUserId String   @db.Uuid @map("super_admin_user_id")
  targetUserId     String   @db.Uuid @map("target_user_id")
  tenantId         String   @db.Uuid @map("tenant_id")
  reason           String
  ipAddress        String?  @map("ip_address")
  startedAt        DateTime @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at")
  createdAt        DateTime @default(now()) @map("created_at")

  superAdmin  User   @relation("superAdminImpersonation", fields: [superAdminUserId], references: [id], onDelete: Restrict)
  targetUser  User   @relation("targetImpersonation", fields: [targetUserId], references: [id], onDelete: Restrict)
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([superAdminUserId, startedAt])
  @@index([targetUserId, startedAt])
  @@map("impersonation_sessions")
}

model Company {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  name       String
  domain     String?
  industry   String?
  size       String?
  description String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String   @db.Uuid @map("created_by")
  updatedBy  String   @db.Uuid @map("updated_by")

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts   Contact[]
  leads      Lead[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@map("companies")
}

model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  name      String
  email     String?
  phone     String?
  title     String?
  companyId String?  @db.Uuid @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @db.Uuid @map("created_by")
  updatedBy String   @db.Uuid @map("updated_by")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leadContacts LeadContact[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("contacts")
}

model LeadSource {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid @map("tenant_id")
  name            String
  isSystemDefault Boolean  @default(false) @map("is_system_default")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("lead_sources")
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  name      String
  color     String   @default("blue")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadTags LeadTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

model Lead {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid @map("tenant_id")
  name           String
  email          String?
  phone          String?
  jobTitle       String?  @map("job_title")
  sourceId       String?  @db.Uuid @map("source_id")
  companyId      String?  @db.Uuid @map("company_id")
  status         String   @default("new") // new|contacted|qualified|unqualified|won|lost
  pipelineId     String?  @db.Uuid @map("pipeline_id")
  stageId        String?  @db.Uuid @map("stage_id")
  ownerUserId    String?  @db.Uuid @map("owner_user_id")
  teamId         String?  @db.Uuid @map("team_id")
  score          Int      @default(0)
  estimatedValue Float?   @map("estimated_value")
  priority       String   @default("medium") // low|medium|high
  description    String?
  lastActivityAt DateTime? @map("last_activity_at")
  nextActivityAt DateTime? @map("next_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String   @db.Uuid @map("created_by")
  updatedBy      String   @db.Uuid @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source           LeadSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerUser        User?            @relation("leadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  team             Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  pipeline         Pipeline?        @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  leadContacts     LeadContact[]
  leadTags         LeadTag[]
  customFieldValues CustomFieldValue[]
  activities       Activity[]
  notes            Note[]
  tasks            Task[]
  automationRuns   AutomationRun[]
  scoreHistories   LeadScoreHistory[]
  emailEnrollments EmailSequenceEnrollment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, teamId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, createdAt])
  @@map("leads")
}

model LeadContact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid @map("tenant_id")
  leadId       String   @db.Uuid @map("lead_id")
  contactId    String   @db.Uuid @map("contact_id")
  relationship String?
  createdAt    DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([leadId, contactId])
  @@index([tenantId])
  @@map("lead_contacts")
}

model LeadTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  leadId    String   @db.Uuid @map("lead_id")
  tagId     String   @db.Uuid @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([leadId, tagId])
  @@index([tenantId])
  @@map("lead_tags")
}

model CustomFieldDefinition {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid @map("tenant_id")
  entityType    String   @map("entity_type") // lead|contact|company
  key           String
  label         String
  fieldType     String   @map("field_type") // text|textarea|number|currency|date|boolean|select|email|phone|url
  required      Boolean  @default(false)
  defaultValue  String?  @map("default_value")
  options       Json?    // for select/multi-select: [{label, value}, ...]
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@unique([tenantId, entityType, key])
  @@index([tenantId, entityType])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @db.Uuid @map("tenant_id")
  entityType          String   @map("entity_type") // lead|contact|company
  entityId            String   @db.Uuid @map("entity_id")
  fieldDefinitionId   String   @db.Uuid @map("field_definition_id")
  value               Json?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fieldDefinition   CustomFieldDefinition   @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  lead              Lead?                   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, fieldDefinitionId])
  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("custom_field_values")
}

model SavedView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  userId    String   @db.Uuid @map("user_id")
  name      String
  filters   Json     @default("{}")
  columns   Json?
  sortBy    String?  @map("sort_by")
  sortOrder String   @default("asc") @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("saved_views")
}

model ImportJob {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid @map("tenant_id")
  userId         String   @db.Uuid @map("user_id")
  status         String   @default("uploading") // uploading|mapping|validating|duplicates|importing|completed|failed
  fileUrl        String   @map("file_url")
  columnMapping  Json?    @map("column_mapping")
  totalRows      Int      @default(0) @map("total_rows")
  importedRows   Int      @default(0) @map("imported_rows")
  errorCount     Int      @default(0) @map("error_count")
  errors         Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  completedAt    DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("import_jobs")
}

model Pipeline {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  leads  Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("pipelines")
}

model PipelineStage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid @map("tenant_id")
  pipelineId   String   @db.Uuid @map("pipeline_id")
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  probability  Int      @default(50) // 0-100 likelihood of winning
  isWon        Boolean  @default(false) @map("is_won")
  isLost       Boolean  @default(false) @map("is_lost")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([tenantId, pipelineId])
  @@map("pipeline_stages")
}

model Activity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  leadId    String   @db.Uuid @map("lead_id")
  type      String   // note|call|email|meeting|task|stage_change|assignment|system_event
  actorUserId String @db.Uuid @map("actor_user_id")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
  @@map("activities")
}

model Note {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  leadId    String   @db.Uuid @map("lead_id")
  authorUserId String @db.Uuid @map("author_user_id")
  body      String
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, leadId, deletedAt])
  @@index([tenantId, createdAt])
  @@map("notes")
}

model Task {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid @map("tenant_id")
  leadId         String   @db.Uuid @map("lead_id")
  title          String
  assigneeUserId String?  @db.Uuid @map("assignee_user_id")
  priority       String   @default("medium") // low|medium|high
  dueDate        DateTime? @map("due_date")
  status         String   @default("open") // open|completed|cancelled
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  completedAt    DateTime? @map("completed_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee User?  @relation(fields: [assigneeUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, assigneeUserId, status])
  @@index([tenantId, dueDate])
  @@map("tasks")
}

model AutomationRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  name      String
  triggerType String // lead_created|lead_updated|lead_scored|manual|webhook
  conditions Json    @default("[]") // array of conditions to match
  actions   Json    @default("[]") // array of actions to execute
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]

  @@index([tenantId, isActive])
  @@map("automation_rules")
}

model AutomationRun {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  ruleId    String   @db.Uuid @map("rule_id")
  leadId    String   @db.Uuid @map("lead_id")
  status    String   @default("pending") // pending|running|success|failed
  error     String?
  startedAt DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([ruleId, createdAt])
  @@map("automation_runs")
}

model LeadScoreHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  leadId    String   @db.Uuid @map("lead_id")
  oldScore  Int      @map("old_score")
  newScore  Int      @map("new_score")
  reason    String?  // why the score changed
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
  @@map("lead_score_history")
}

model EmailSequence {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps       EmailSequenceStep[]
  enrollments EmailSequenceEnrollment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("email_sequences")
}

model EmailSequenceStep {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequenceId   String   @db.Uuid @map("sequence_id")
  stepNumber   Int      @map("step_number")
  subject      String
  body         String   // HTML template
  delayMinutes Int      @default(0) @map("delay_minutes")
  createdAt    DateTime @default(now()) @map("created_at")

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, stepNumber])
  @@index([sequenceId])
  @@map("email_sequence_steps")
}

model EmailSequenceEnrollment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequenceId String   @db.Uuid @map("sequence_id")
  leadId     String   @db.Uuid @map("lead_id")
  status     String   @default("active") // active|paused|completed|cancelled
  currentStep Int     @default(1) @map("current_step")
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  pausedAt   DateTime? @map("paused_at")
  completedAt DateTime? @map("completed_at")

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, leadId])
  @@index([sequenceId, status])
  @@map("email_sequence_enrollments")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  userId    String   @db.Uuid @map("user_id")
  type      String   // assignment|task_due|task_overdue|mention|stage_change|system
  title     String
  body      String?
  leadId    String?  @db.Uuid @map("lead_id")
  taskId    String?  @db.Uuid @map("task_id")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ReportSnapshot {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  reportType  String   @map("report_type") // lead_overview|pipeline_funnel|conversion|rep_performance|team_performance|sources
  params      Json     @default("{}") // filters: dateRange, userId, teamId, etc
  data        Json     @default("{}") // aggregated report data
  computedAt  DateTime @map("computed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reportType, params])
  @@index([tenantId, reportType])
  @@index([computedAt])
  @@map("report_snapshots")
}

model CsvExport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  userId      String   @db.Uuid @map("user_id")
  exportType  String   @map("export_type") // leads|contacts|companies|reports
  filters     Json     @default("{}") // export filter params
  status      String   @default("pending") // pending|processing|completed|failed
  rowCount    Int      @default(0) @map("row_count")
  fileUrl     String?  @map("file_url")
  error       String?
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([userId, createdAt])
  @@map("csv_exports")
}

model TenantSettings {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @unique @db.Uuid @map("tenant_id")
  timezone      String   @default("UTC")
  dateFormat    String   @default("MM/DD/YYYY") @map("date_format")
  currency      String   @default("USD")
  language      String   @default("en")
  leadDefaults  Json     @default("{}") @map("lead_defaults") // default status, priority, source
  branding      Json     @default("{}") // logo, colors, company name
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model NotificationPreference {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  userId    String   @db.Uuid @map("user_id")
  eventType String   @map("event_type") // assignment|task_due|mention|stage_change
  emailEnabled Boolean @default(true) @map("email_enabled")
  inAppEnabled Boolean @default(true) @map("in_app_enabled")
  pushEnabled Boolean @default(false) @map("push_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, eventType])
  @@index([tenantId, userId])
  @@map("notification_preferences")
}

model SyncStatus {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  userId    String   @db.Uuid @map("user_id")
  status    String   @default("synced") // synced|syncing|offline|failed
  lastSyncAt DateTime? @map("last_sync_at")
  lastError String?   @map("last_error")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@map("sync_statuses")
}





