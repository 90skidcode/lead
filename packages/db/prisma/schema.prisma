generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("active") // active|suspended
  plan      String   @default("starter")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                     TenantUser[]
  teams                     Team[]
  invitations               Invitation[]
  auditLogs                 AuditLog[]
  impersonationSessions     ImpersonationSession[]
  companies                 Company[]
  contacts                  Contact[]
  leadSources               LeadSource[]
  tags                      Tag[]
  leads                     Lead[]
  leadContacts              LeadContact[]
  leadTags                  LeadTag[]
  customFieldDefinitions    CustomFieldDefinition[]
  customFieldValues         CustomFieldValue[]
  savedViews                SavedView[]
  importJobs                ImportJob[]

  @@index([slug])
  @@map("tenants")
}

model User {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String   @unique
  passwordHash         String   @map("password_hash")
  emailVerifiedAt      DateTime? @map("email_verified_at")
  isPlatformSuperAdmin Boolean  @default(false) @map("is_platform_super_admin")
  status               String   @default("active") // active|disabled
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenants                        TenantUser[]
  invitedInvitations             Invitation[] @relation("invitedBy")
  createdAuditLogs               AuditLog[]   @relation("actor")
  impersonationSessionsAsAdmin   ImpersonationSession[] @relation("superAdminImpersonation")
  impersonationSessionsAsTarget  ImpersonationSession[] @relation("targetImpersonation")
  ownedLeads                     Lead[] @relation("leadOwner")
  savedViews                     SavedView[]
  importJobs                     ImportJob[]

  @@map("users")
}

model TenantUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  userId    String   @db.Uuid @map("user_id")
  role      String   // OWNER|ADMIN|MANAGER|SALES_REP|VIEWER
  teamId    String?  @db.Uuid @map("team_id")
  status    String   @default("active") // active|invited|deactivated
  invitedBy String?  @db.Uuid @map("invited_by")
  invitedAt DateTime? @map("invited_at")
  joinedAt  DateTime? @map("joined_at")
  deactivatedAt DateTime? @map("deactivated_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  inviter   User?  @relation("invitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@map("tenant_users")
}

model Team {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  name        String
  managerUserId String? @db.Uuid @map("manager_user_id")
  status      String   @default("active") // active|inactive
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     TenantUser[]
  leads       Lead[]

  @@index([tenantId])
  @@map("teams")
}

model Invitation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  email       String
  role        String   // OWNER|ADMIN|MANAGER|SALES_REP|VIEWER
  teamId      String?  @db.Uuid @map("team_id")
  tokenHash   String   @map("token_hash")
  status      String   @default("pending") // pending|accepted|cancelled|expired
  invitedBy   String   @db.Uuid @map("invited_by")
  expiresAt   DateTime @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter     User   @relation("invitedBy", fields: [invitedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, email, tokenHash])
  @@index([tenantId, status])
  @@map("invitations")
}

model AuditLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String?  @db.Uuid @map("tenant_id")
  actorUserId      String   @db.Uuid @map("actor_user_id")
  actorIsSuperAdmin Boolean  @default(false) @map("actor_is_super_admin")
  action           String
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  metadata         Json     @default("{}")
  ipAddress        String?  @map("ip_address")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor     User    @relation("actor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model ImpersonationSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  superAdminUserId String   @db.Uuid @map("super_admin_user_id")
  targetUserId     String   @db.Uuid @map("target_user_id")
  tenantId         String   @db.Uuid @map("tenant_id")
  reason           String
  ipAddress        String?  @map("ip_address")
  startedAt        DateTime @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at")
  createdAt        DateTime @default(now()) @map("created_at")

  superAdmin  User   @relation("superAdminImpersonation", fields: [superAdminUserId], references: [id], onDelete: Restrict)
  targetUser  User   @relation("targetImpersonation", fields: [targetUserId], references: [id], onDelete: Restrict)
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([superAdminUserId, startedAt])
  @@index([targetUserId, startedAt])
  @@map("impersonation_sessions")
}

model Company {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  name       String
  domain     String?
  industry   String?
  size       String?
  description String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String   @db.Uuid @map("created_by")
  updatedBy  String   @db.Uuid @map("updated_by")

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts   Contact[]
  leads      Lead[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@map("companies")
}

model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  name      String
  email     String?
  phone     String?
  title     String?
  companyId String?  @db.Uuid @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @db.Uuid @map("created_by")
  updatedBy String   @db.Uuid @map("updated_by")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leadContacts LeadContact[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("contacts")
}

model LeadSource {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid @map("tenant_id")
  name            String
  isSystemDefault Boolean  @default(false) @map("is_system_default")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("lead_sources")
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  name      String
  color     String   @default("blue")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadTags LeadTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

model Lead {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid @map("tenant_id")
  name           String
  email          String?
  phone          String?
  jobTitle       String?  @map("job_title")
  sourceId       String?  @db.Uuid @map("source_id")
  companyId      String?  @db.Uuid @map("company_id")
  status         String   @default("new") // new|contacted|qualified|unqualified|won|lost
  pipelineId     String?  @db.Uuid @map("pipeline_id")
  stageId        String?  @db.Uuid @map("stage_id")
  ownerUserId    String?  @db.Uuid @map("owner_user_id")
  teamId         String?  @db.Uuid @map("team_id")
  score          Int      @default(0)
  estimatedValue Float?   @map("estimated_value")
  priority       String   @default("medium") // low|medium|high
  description    String?
  lastActivityAt DateTime? @map("last_activity_at")
  nextActivityAt DateTime? @map("next_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String   @db.Uuid @map("created_by")
  updatedBy      String   @db.Uuid @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source           LeadSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerUser        User?            @relation("leadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  team             Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  leadContacts     LeadContact[]
  leadTags         LeadTag[]
  customFieldValues CustomFieldValue[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, teamId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, createdAt])
  @@map("leads")
}

model LeadContact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid @map("tenant_id")
  leadId       String   @db.Uuid @map("lead_id")
  contactId    String   @db.Uuid @map("contact_id")
  relationship String?
  createdAt    DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([leadId, contactId])
  @@index([tenantId])
  @@map("lead_contacts")
}

model LeadTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  leadId    String   @db.Uuid @map("lead_id")
  tagId     String   @db.Uuid @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([leadId, tagId])
  @@index([tenantId])
  @@map("lead_tags")
}

model CustomFieldDefinition {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid @map("tenant_id")
  entityType    String   @map("entity_type") // lead|contact|company
  key           String
  label         String
  fieldType     String   @map("field_type") // text|textarea|number|currency|date|boolean|select|email|phone|url
  required      Boolean  @default(false)
  defaultValue  String?  @map("default_value")
  options       Json?    // for select/multi-select: [{label, value}, ...]
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@unique([tenantId, entityType, key])
  @@index([tenantId, entityType])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @db.Uuid @map("tenant_id")
  entityType          String   @map("entity_type") // lead|contact|company
  entityId            String   @db.Uuid @map("entity_id")
  fieldDefinitionId   String   @db.Uuid @map("field_definition_id")
  value               Json?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fieldDefinition   CustomFieldDefinition   @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  lead              Lead?                   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, fieldDefinitionId])
  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("custom_field_values")
}

model SavedView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  userId    String   @db.Uuid @map("user_id")
  name      String
  filters   Json     @default("{}")
  columns   Json?
  sortBy    String?  @map("sort_by")
  sortOrder String   @default("asc") @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("saved_views")
}

model ImportJob {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid @map("tenant_id")
  userId         String   @db.Uuid @map("user_id")
  status         String   @default("uploading") // uploading|mapping|validating|duplicates|importing|completed|failed
  fileUrl        String   @map("file_url")
  columnMapping  Json?    @map("column_mapping")
  totalRows      Int      @default(0) @map("total_rows")
  importedRows   Int      @default(0) @map("imported_rows")
  errorCount     Int      @default(0) @map("error_count")
  errors         Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  completedAt    DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("import_jobs")
}

