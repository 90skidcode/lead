# ============================================================================
# DATABASE - PostgreSQL via Supabase
# ============================================================================
# Primary connection for Prisma ORM (use with sslmode=require for production)
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres?schema=public&sslmode=require

# Direct URL for migrations (optional, same as DATABASE_URL for most cases)
DIRECT_URL=postgresql://postgres:password@db.supabase.co:5432/postgres?schema=public&sslmode=require

# ============================================================================
# SUPABASE - Real-time & PowerSync
# ============================================================================
# Required for: PowerSync offline sync, real-time subscriptions, RLS enforcement
# Get from: Supabase Dashboard > Settings > API

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (client-safe, use for public access)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# POWERSYNC - Offline-first SQLite Sync
# ============================================================================
# Required for: Offline-first local sync, conflict-free replicated data
# Get from: PowerSync Dashboard > Sync Rules & Configuration

# PowerSync instance URL
POWERSYNC_URL=https://your-instance.powersync.co

# PowerSync authentication token secret (for JWT signing)
POWERSYNC_TOKEN_SECRET=your-powersync-token-secret-min-32-chars

# ============================================================================
# INNGEST - Background Jobs & Async Processing
# ============================================================================
# Required for: Email sequences, automation rules, bulk operations, scheduled tasks
# Get from: Inngest Dashboard > Environments > Keys

# Inngest event key (for sending events)
INNGEST_EVENT_KEY=your-inngest-event-key

# Inngest signing key (for webhook verification)
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ============================================================================
# RESEND - Email Service
# ============================================================================
# Required for: Sending email notifications, email sequences, password resets
# Get from: Resend > API Keys

# Resend API key
RESEND_API_KEY=re_your_resend_api_key

# ============================================================================
# AUTHENTICATION & SESSION
# ============================================================================
# Session JWT secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your-random-32-character-hex-string-here-min-32-chars

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Public app URL (used in emails, redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# ============================================================================
# OPTIONAL: Vercel / Production Specific
# ============================================================================
# For Vercel deployments, set DATABASE_URL with connection pooling:
# DATABASE_URL=postgresql://user:password@db.region.supabase.co:5432/postgres?schema=public&sslmode=require

# For Vercel deployments, use environment-specific URLs:
# SUPABASE_URL and SUPABASE_ANON_KEY should point to production Supabase project
